GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # or "hash" for offline/fast tests
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=10
RAG_KEEP_TOP=5
ADO_MODE=mock                       # mock | live
ADO_ORG_URL=
ADO_PROJECT=
ADO_PAT=
CONFLUENCE_MODE=mock                # mock | live
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=
TEST_RUNNER=mock                    # mock | local_command
TEST_RUNNER_COMMAND=mvn -q test
RELEASE_POLL_MINUTES=5
